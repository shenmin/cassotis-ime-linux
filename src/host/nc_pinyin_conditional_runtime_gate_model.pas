function nc_pinyin_conditional_gate_score(
    const values: TncPinyinConditionalGateFeatures): Double;
var
    tree_index: Integer;
    node_index: Integer;
begin
    Result := 0.0;
    for tree_index := Low(c_tree_roots) to High(c_tree_roots) do
    begin
        node_index := c_tree_roots[tree_index];
        while node_index >= 0 do
        begin
            if values[c_node_features[node_index]] <=
                c_node_thresholds[node_index] then
            begin
                node_index := c_node_left[node_index];
            end
            else
            begin
                node_index := c_node_right[node_index];
            end;
        end;
        Result := Result + c_leaf_values[-node_index - 1];
    end;
end;

