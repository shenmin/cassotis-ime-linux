function nc_pinyin_generator_invocation_gate_score(
    const values: TncPinyinGeneratorInvocationGateFeatures): Double;
var
    tree_index: Integer;
    node_index: Integer;
    value: Double;
    go_left: Boolean;
begin
    Result := 0.0;
    for tree_index := Low(c_tree_roots) to High(c_tree_roots) do
    begin
        node_index := c_tree_roots[tree_index];
        while node_index >= 0 do
        begin
            value := values[c_node_features[node_index]];
            go_left := value <= c_node_thresholds[node_index];
            if go_left then
            begin
                node_index := c_node_left[node_index];
            end
            else
            begin
                node_index := c_node_right[node_index];
            end;
        end;
        Result := Result + c_leaf_values[-node_index - 1];
    end;
end;

