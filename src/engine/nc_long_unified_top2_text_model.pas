    reference_candidate_path = #$4E5F + #$0003 + #$8FC7 + #$4E0D + #$0003 + #$6210 + #$0003 + #$666E + #$901A + #$4EBA + #$0003 + #$7684 + #$0003 + #$751F + #$6D3B;
    reference_syllables: array[0..9] of string = (
