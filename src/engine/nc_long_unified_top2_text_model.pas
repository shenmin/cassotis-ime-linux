  candidates. It performs no dictionary lookup and cannot alter the pool.
  Training report SHA-256: EC927493AB37750C6083390A604502C31F81F01AA3FE475B0D89C0193E14706B
  Model SHA-256: EC98CC9DB860E4D04C7F76E9571DB90FC9F43CF5056C51A4FF3662F78CE1A0CA }

function fnv_update(const value: Cardinal; const item: Byte): Cardinal;
begin
    Result := Cardinal((UInt64(value xor item) * c_fnv_prime) and $FFFFFFFF);
end;

function hash_feature(const namespace_value: Byte;
    const value: string): Cardinal;
var
    hash_value: Cardinal;
    idx: Integer;
    code_unit: Word;
begin
    hash_value := fnv_update(c_fnv_offset, namespace_value);
    for idx := 1 to Length(value) do
    begin
        code_unit := Ord(value[idx]);
        hash_value := fnv_update(hash_value, Byte(code_unit and $FF));
        hash_value := fnv_update(hash_value, Byte(code_unit shr 8));
    end;
    Result := hash_value and c_long_unified_top2_text_hash_mask;
end;

procedure add_feature(var score: Int64; const namespace_value: Byte;
    const value: string; const multiplier: Integer = 1);
begin
    if value = '' then Exit;
    Inc(score, Int64(c_coefficients[hash_feature(namespace_value, value)]) *
        multiplier);
end;

function split_text_units(const value: string): TStringArray;
var
    idx: Integer;
    count: Integer;
    current: Word;
begin
    SetLength(Result, Length(value));
    idx := 1;
    count := 0;
    while idx <= Length(value) do
    begin
        current := Ord(value[idx]);
        if (current >= $D800) and (current <= $DBFF) and
            (idx < Length(value)) and (Ord(value[idx + 1]) >= $DC00) and
            (Ord(value[idx + 1]) <= $DFFF) then
        begin
            Result[count] := Copy(value, idx, 2);
            Inc(idx, 2);
        end
        else
        begin
            Result[count] := value[idx];
            Inc(idx);
        end;
        Inc(count);
    end;
    SetLength(Result, count);
end;

function split_segments(const value: string): TStringArray;
var
    idx: Integer;
    start_idx: Integer;
    count: Integer;
begin
    SetLength(Result, 0);
    start_idx := 1;
    count := 0;
    for idx := 1 to Length(value) + 1 do
    begin
        if (idx <= Length(value)) and (value[idx] <> #3) then Continue;
        if idx > start_idx then
        begin
            SetLength(Result, count + 1);
            Result[count] := Copy(value, start_idx, idx - start_idx);
            Inc(count);
        end;
        start_idx := idx + 1;
    end;
end;

function join_units(const units: TStringArray; const start_idx: Integer;
    const width: Integer): string;
var
    idx: Integer;
begin
    Result := '';
    for idx := start_idx to start_idx + width - 1 do
        if (idx >= 0) and (idx < Length(units)) then
            Result := Result + units[idx];
end;

function join_values(const values: TStringArray; const start_idx: Integer;
    const stop_idx: Integer; const separator: string): string;
var
    idx: Integer;
begin
    Result := '';
    for idx := start_idx to stop_idx - 1 do
    begin
        if (idx < 0) or (idx >= Length(values)) then Continue;
        if Result <> '' then Result := Result + separator;
        Result := Result + values[idx];
    end;
end;

procedure score_text_features(const text: string; const path: string;
    const multiplier: Integer; var score: Int64);
var
    units: TStringArray;
    segments: TStringArray;
    width: Integer;
    idx: Integer;
begin
    units := split_text_units(text);
    for width := 1 to 4 do
    begin
        for idx := 0 to Length(units) - width do
            add_feature(score, $10 + width,
                join_units(units, idx, width), multiplier);
        if Length(units) >= width then
        begin
            add_feature(score, $20 + width,
                join_units(units, 0, width), multiplier);
            add_feature(score, $30 + width,
                join_units(units, Length(units) - width, width), multiplier);
        end;
    end;
    segments := split_segments(path);
    for idx := 0 to High(segments) do
        add_feature(score, $50, segments[idx], multiplier);
    for idx := 0 to Length(segments) - 2 do
        add_feature(score, $51, segments[idx] + #3 + segments[idx + 1],
            multiplier);
    for idx := 0 to Length(segments) - 3 do
        add_feature(score, $52, segments[idx] + #3 + segments[idx + 1] +
            #3 + segments[idx + 2], multiplier);
end;

procedure build_path_layout(const text: string; const path: string;
    out layout: TPathLayout);
var
    idx: Integer;
    offset: Integer;
    segment_units: TStringArray;
    rebuilt: string;
begin
    layout.valid := False;
    layout.segments := split_segments(path);
    SetLength(layout.starts, Length(layout.segments));
    SetLength(layout.ends, Length(layout.segments));
    offset := 0;
    rebuilt := '';
    for idx := 0 to High(layout.segments) do
    begin
        layout.starts[idx] := offset;
        segment_units := split_text_units(layout.segments[idx]);
        Inc(offset, Length(segment_units));
        layout.ends[idx] := offset;
        rebuilt := rebuilt + layout.segments[idx];
    end;
    layout.valid := (Length(layout.segments) > 0) and (rebuilt = text);
end;

function position_bucket(const start_idx: Integer; const stop_idx: Integer;
    const text_length: Integer): string;
var
    midpoint: Integer;
begin
    if start_idx <= 0 then Exit('B');
    if stop_idx >= text_length then Exit('E');
    midpoint := (start_idx + stop_idx) * 2;
    if midpoint <= text_length then Exit('Q1');
    if midpoint >= text_length * 3 then Exit('Q4');
    Result := 'M';
end;

function contains_value(const values: TIntegerArray;
    const target: Integer): Boolean;
var
    value: Integer;
begin
    for value in values do
        if value = target then Exit(True);
    Result := False;
end;

function find_overlap(const layout: TPathLayout; const start_idx: Integer;
    const stop_idx: Integer; out first_idx: Integer;
    out last_idx: Integer): Boolean;
var
    idx: Integer;
begin
    first_idx := -1;
    last_idx := -1;
    if not layout.valid then Exit(False);
    for idx := 0 to High(layout.segments) do
    begin
        if (layout.starts[idx] < stop_idx) and
            (layout.ends[idx] > start_idx) then
        begin
            if first_idx < 0 then first_idx := idx;
            last_idx := idx;
        end;
    end;
    Result := first_idx >= 0;
end;

function path_context(const layout: TPathLayout; const first_idx: Integer;
    const last_idx: Integer): string;
var
    left_text: string;
    right_text: string;
begin
    if first_idx > 0 then
        left_text := layout.segments[first_idx - 1]
    else
        left_text := '^';
    if last_idx < High(layout.segments) then
        right_text := layout.segments[last_idx + 1]
    else
        right_text := '$';
    Result := left_text + #2 +
        join_values(layout.segments, first_idx, last_idx + 1, #3) +
        #2 + right_text;
end;

procedure score_relation_features(const top_text: string;
    const candidate_text: string; const top_path: string;
    const candidate_path: string; var score: Int64);
var
    top_units: TStringArray;
    candidate_units: TStringArray;
    top_segments: TStringArray;
    candidate_segments: TStringArray;
    idx: Integer;
    stop_idx: Integer;
    pair_text: string;
begin
    top_units := split_text_units(top_text);
    candidate_units := split_text_units(candidate_text);
    if Length(top_units) = Length(candidate_units) then
    begin
        for idx := 0 to High(top_units) do
        begin
            if top_units[idx] = candidate_units[idx] then Continue;
            pair_text := top_units[idx] + #3 + candidate_units[idx];
            add_feature(score, $60, pair_text);
            if idx > 0 then
                add_feature(score, $61, candidate_units[idx - 1] + pair_text);
            if idx < High(candidate_units) then
                add_feature(score, $62, pair_text + candidate_units[idx + 1]);
            if (idx > 0) and (idx < High(candidate_units)) then
                add_feature(score, $63, candidate_units[idx - 1] + pair_text +
                    candidate_units[idx + 1]);
        end;
        idx := 0;
        while idx < Length(top_units) do
        begin
            if top_units[idx] = candidate_units[idx] then
            begin
                Inc(idx);
                Continue;
            end;
            stop_idx := idx + 1;
            while (stop_idx < Length(top_units)) and
                (top_units[stop_idx] <> candidate_units[stop_idx]) do
                Inc(stop_idx);
            if stop_idx - idx <= 4 then
            begin
                pair_text := join_units(top_units, idx, stop_idx - idx) + #3 +
                    join_units(candidate_units, idx, stop_idx - idx);
                add_feature(score, $64, pair_text);
                if idx > 0 then
                    add_feature(score, $65, candidate_units[idx - 1] + pair_text);
                if stop_idx < Length(candidate_units) then
                    add_feature(score, $66, pair_text + candidate_units[stop_idx]);
            end;
            idx := stop_idx;
        end;
    end;
    top_segments := split_segments(top_path);
    candidate_segments := split_segments(candidate_path);
    if Length(top_segments) = Length(candidate_segments) then
        for idx := 0 to High(top_segments) do
            if top_segments[idx] <> candidate_segments[idx] then
                add_feature(score, $70, top_segments[idx] + #3 +
                    candidate_segments[idx]);
end;

procedure score_aligned_features(
    const query_syllables: TncLongUnifiedTop2TextPinyinSyllables;
    const top_text: string; const candidate_text: string;
    const top_path: string; const candidate_path: string;
    var score: Int64);
var
    top_units: TStringArray;
    candidate_units: TStringArray;
    top_layout: TPathLayout;
    candidate_layout: TPathLayout;
    runs_start: TIntegerArray;
    runs_stop: TIntegerArray;
    equal_length: Boolean;
    pinyin_aligned: Boolean;
    idx: Integer;
    run_idx: Integer;
    stop_idx: Integer;
    shared: Integer;
    suffix: Integer;
    start_idx: Integer;
    top_stop: Integer;
    candidate_stop: Integer;
    radius: Integer;
    window_start: Integer;
    window_stop: Integer;
    top_first: Integer;
    top_last: Integer;
    candidate_first: Integer;
    candidate_last: Integer;
    max_length: Integer;
    pair_text: string;
    span_pair: string;
    pinyin_span: string;
    top_window: string;
    candidate_window: string;
    pinyin_window: string;
    top_words: string;
    candidate_words: string;
    word_pair: string;
    top_boundaries: string;
    candidate_boundaries: string;
begin
    top_units := split_text_units(top_text);
    candidate_units := split_text_units(candidate_text);
    equal_length := Length(top_units) = Length(candidate_units);
    pinyin_aligned := equal_length and
        (Length(query_syllables) = Length(top_units));
    build_path_layout(top_text, top_path, top_layout);
    build_path_layout(candidate_text, candidate_path, candidate_layout);

    SetLength(runs_start, 0);
    SetLength(runs_stop, 0);
    if equal_length then
    begin
        idx := 0;
        while idx < Length(top_units) do
        begin
            if top_units[idx] = candidate_units[idx] then
            begin
                Inc(idx);
                Continue;
            end;
            stop_idx := idx + 1;
            while (stop_idx < Length(top_units)) and
                (top_units[stop_idx] <> candidate_units[stop_idx]) do
                Inc(stop_idx);
            SetLength(runs_start, Length(runs_start) + 1);
            SetLength(runs_stop, Length(runs_stop) + 1);
            runs_start[High(runs_start)] := idx;
            runs_stop[High(runs_stop)] := stop_idx;
            idx := stop_idx;
        end;
    end
    else
    begin
        shared := Length(top_units);
        if Length(candidate_units) < shared then shared := Length(candidate_units);
        idx := 0;
        while (idx < shared) and (top_units[idx] = candidate_units[idx]) do
            Inc(idx);
        suffix := 0;
        while (suffix < shared - idx) and
            (top_units[High(top_units) - suffix] =
            candidate_units[High(candidate_units) - suffix]) do
            Inc(suffix);
        SetLength(runs_start, 1);
        SetLength(runs_stop, 1);
        runs_start[0] := idx;
        if Length(top_units) > Length(candidate_units) then
            runs_stop[0] := Length(top_units) - suffix
        else
            runs_stop[0] := Length(candidate_units) - suffix;
    end;

    if equal_length then
        for idx := 0 to High(top_units) do
        begin
            if top_units[idx] = candidate_units[idx] then Continue;
            pair_text := top_units[idx] + #3 + candidate_units[idx];
            if pinyin_aligned then
            begin
                add_feature(score, $80, query_syllables[idx] + #3 + pair_text);
                add_feature(score, $81,
                    join_values(query_syllables, idx - 1, idx + 2, #3) +
                    #2 + pair_text);
                add_feature(score, $82,
                    position_bucket(idx, idx + 1, Length(top_units)) + #2 +
                    query_syllables[idx] + #2 + pair_text);
            end;
        end;

    if Length(top_units) > Length(candidate_units) then
        max_length := Length(top_units)
    else
        max_length := Length(candidate_units);
    for run_idx := 0 to High(runs_start) do
    begin
        start_idx := runs_start[run_idx];
        stop_idx := runs_stop[run_idx];
        top_stop := stop_idx;
        if top_stop > Length(top_units) then top_stop := Length(top_units);
        candidate_stop := stop_idx;
        if candidate_stop > Length(candidate_units) then
            candidate_stop := Length(candidate_units);
        span_pair := join_units(top_units, start_idx, top_stop - start_idx) +
            #3 + join_units(candidate_units, start_idx,
            candidate_stop - start_idx);
        add_feature(score, $83, span_pair);
        add_feature(score, $84,
            position_bucket(start_idx, stop_idx, max_length) + #2 + span_pair);
        if pinyin_aligned then
        begin
            pinyin_span := join_values(query_syllables, start_idx,
                stop_idx, #3);
            add_feature(score, $85, pinyin_span + #2 + span_pair);
        end;

        for radius := 1 to 4 do
        begin
            window_start := start_idx - radius;
            if window_start < 0 then window_start := 0;
            window_stop := stop_idx + radius;
            if window_stop > Length(top_units) then
                window_stop := Length(top_units);
            top_window := join_units(top_units, window_start,
                window_stop - window_start);
            candidate_window := join_units(candidate_units, window_start,
                window_stop - window_start);
            add_feature(score, $90 + radius - 1,
                top_window + #3 + candidate_window);
            if pinyin_aligned then
            begin
                pinyin_window := join_values(query_syllables, window_start,
                    window_stop, #3);
                add_feature(score, $98 + radius - 1,
                    pinyin_window + #2 + top_window + #3 + candidate_window);
            end;
        end;

        if (not find_overlap(top_layout, start_idx, top_stop,
            top_first, top_last)) or
            (not find_overlap(candidate_layout, start_idx, candidate_stop,
            candidate_first, candidate_last)) then Continue;
        top_words := join_values(top_layout.segments, top_first,
            top_last + 1, #3);
        candidate_words := join_values(candidate_layout.segments,
            candidate_first, candidate_last + 1, #3);
        word_pair := top_words + #2 + candidate_words;
        add_feature(score, $B0, word_pair);
        if pinyin_aligned then
            add_feature(score, $B1,
                join_values(query_syllables, start_idx, stop_idx, #3) +
                #2 + word_pair);
        add_feature(score, $B2,
            path_context(top_layout, top_first, top_last) + #3 +
            path_context(candidate_layout, candidate_first, candidate_last));
        top_boundaries := IntToStr(Ord(contains_value(top_layout.starts,
            start_idx))) + IntToStr(Ord(contains_value(top_layout.ends,
            stop_idx)));
        candidate_boundaries := IntToStr(Ord(contains_value(
            candidate_layout.starts, start_idx))) + IntToStr(Ord(
            contains_value(candidate_layout.ends, stop_idx)));
        add_feature(score, $B3, top_boundaries + #3 +
            candidate_boundaries + #2 + word_pair);
    end;
end;

function long_unified_top2_text_score(
    const query_syllables: TncLongUnifiedTop2TextPinyinSyllables;
    const candidate_text: string; const top_text: string;
    const candidate_path: string; const top_path: string): Int64;
begin
    Result := c_long_unified_top2_text_intercept;



    score_aligned_features(query_syllables, top_text, candidate_text,
        top_path, candidate_path, Result);
end;

function long_unified_top2_text_combined_score(const numeric_score: Int64;
    const query_syllables: TncLongUnifiedTop2TextPinyinSyllables;
    const candidate_text: string; const top_text: string;
    const candidate_path: string; const top_path: string): Int64;
var
    text_score: Int64;
begin
    text_score := long_unified_top2_text_score(query_syllables,
        candidate_text, top_text, candidate_path, top_path);
    Result := Trunc(numeric_score *
        c_long_unified_top2_text_base_scale_numerator /
        c_long_unified_top2_text_base_scale_denominator) + Trunc(
        text_score * c_long_unified_top2_text_blend_numerator *
        c_long_unified_top2_text_numeric_score_scale /
        (c_long_unified_top2_text_coefficient_scale *
        c_long_unified_top2_text_blend_denominator));
end;

