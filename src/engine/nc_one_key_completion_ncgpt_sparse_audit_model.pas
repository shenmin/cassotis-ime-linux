function fnv_update(const value: UInt64; const byte_value: Byte): UInt64; inline;
begin
    Result := (value xor UInt64(byte_value)) * c_fnv_prime;
end;

function hash_text(const value: string): UInt64;
var
    idx: Integer;
    code_unit: Word;
begin
    Result := c_fnv_offset;
    for idx := 1 to Length(value) do
    begin
        code_unit := Ord(value[idx]);
        Result := fnv_update(Result, Byte(code_unit and $FF));
        Result := fnv_update(Result, Byte(code_unit shr 8));
    end;
end;

procedure hash_append(var hash_value: UInt64; const value: string);
var
    idx: Integer;
    code_unit: Word;
begin
    for idx := 1 to Length(value) do
    begin
        code_unit := Ord(value[idx]);
        hash_value := fnv_update(hash_value, Byte(code_unit and $FF));
        hash_value := fnv_update(hash_value, Byte(code_unit shr 8));
    end;
end;

function find_score(const hashes: array of UInt64;
    const scores: array of SmallInt; const hash_value: UInt64;
    out score: Double): Boolean;
var
    left_idx, right_idx, middle_idx: Integer;
begin
    left_idx := 0;
    right_idx := High(hashes);
    while left_idx <= right_idx do
    begin
        middle_idx := left_idx + (right_idx - left_idx) div 2;
        if hashes[middle_idx] = hash_value then
        begin
            score := scores[middle_idx] /
                c_one_key_completion_ncgpt_sparse_score_scale;
            Exit(True);
        end;
        if hashes[middle_idx] < hash_value then
        begin
            left_idx := middle_idx + 1;
        end
        else
        begin
            right_idx := middle_idx - 1;
        end;
    end;
    score := 0.0;
    Result := False;
end;

function source_code(const source: TncOneKeyCompletionSource): string; inline;
begin
    case source of
        okcs_user_exact: Result := 'u';
        okcs_base_exact: Result := 'b';
        okcs_transition: Result := 't';
    else
        Result := 'n';
    end;
end;

function category_code(
    const category: TncOneKeyCompletionDifferenceCategory): string;
begin
    case category of
        okdc_base_to_transition: Result := 'base_to_transition';
        okdc_transition_to_base: Result := 'transition_to_base';
        okdc_hot_exact: Result := 'hot_exact';
        okdc_warm_exact: Result := 'warm_exact';
        okdc_cold_vertical_exact: Result := 'cold_vertical_exact';
    else
        Result := 'generic';
    end;
end;

function text_units(const value: string): TArray<string>;
var
    idx, count: Integer;
begin
    SetLength(Result, Length(value));
    idx := 1;
    count := 0;
    while idx <= Length(value) do
    begin
        if (Ord(value[idx]) >= $D800) and (Ord(value[idx]) <= $DBFF) and
            (idx < Length(value)) and (Ord(value[idx + 1]) >= $DC00) and
            (Ord(value[idx + 1]) <= $DFFF) then
        begin
            Result[count] := Copy(value, idx, 2);
            Inc(idx, 2);
        end
        else
        begin
            Result[count] := value[idx];
            Inc(idx);
        end;
        Inc(count);
    end;
    SetLength(Result, count);
end;

function join_units(const values: TArray<string>; const start_idx,
    count: Integer): string;
var
    idx, stop_idx: Integer;
begin
    Result := '';
    stop_idx := Min(Length(values), start_idx + Max(0, count));
    for idx := Max(0, start_idx) to stop_idx - 1 do
    begin
        Result := Result + values[idx];
    end;
end;

procedure difference_fragments(const incumbent_text, challenger_text: string;
    out incumbent_fragment, challenger_fragment: string;
    out common_prefix, common_suffix: Integer);
var
    incumbent_units, challenger_units: TArray<string>;
    compare_limit: Integer;
begin
    incumbent_units := text_units(incumbent_text);
    challenger_units := text_units(challenger_text);
    common_prefix := 0;
    common_suffix := 0;
    compare_limit := Min(Length(incumbent_units), Length(challenger_units));
    while (common_prefix < compare_limit) and
        (incumbent_units[common_prefix] = challenger_units[common_prefix]) do
    begin
        Inc(common_prefix);
    end;
    compare_limit := compare_limit - common_prefix;
    while (common_suffix < compare_limit) and
        (incumbent_units[High(incumbent_units) - common_suffix] =
        challenger_units[High(challenger_units) - common_suffix]) do
    begin
        Inc(common_suffix);
    end;
    incumbent_fragment := join_units(incumbent_units, common_prefix,
        Min(6, Length(incumbent_units) - common_prefix - common_suffix));
    challenger_fragment := join_units(challenger_units, common_prefix,
        Min(6, Length(challenger_units) - common_prefix - common_suffix));
end;

function pinyin_remainder(const query_text, full_pinyin: string): string;
begin
    if Copy(full_pinyin, 1, Length(query_text)) = query_text then
    begin
        Result := Copy(full_pinyin, Length(query_text) + 1, MaxInt);
    end
    else
    begin
        Result := full_pinyin;
    end;
    Result := Copy(Result, 1, 16);
end;

function lookup_prior(const hashes: array of UInt64;
    const scores: array of SmallInt; const context_value, query_text: string;
    const incumbent, challenger: TncOneKeyCompletion;
    const category: TncOneKeyCompletionDifferenceCategory;
    const selector_score, selector_threshold: Double;
    out prior_score: Double): Boolean;
const
    c_widths: array[0..5] of Integer = (6, 4, 3, 2, 1, 0);
var
    incumbent_fragment, challenger_fragment: string;
    incumbent_remainder, challenger_remainder: string;
    source_pair, category_value, bucket_value: string;
    common_prefix, common_suffix: Integer;
    width_idx, width: Integer;
    context_value_suffix: string;
    context_units: TArray<string>;
    hash_value: UInt64;

    function try_key(const family, query_value: string;
        const payload: array of string): Boolean;
    var
        payload_idx: Integer;
    begin
        hash_value := c_fnv_offset;
        hash_append(hash_value, family);
        hash_append(hash_value, #3);
        hash_append(hash_value, IntToStr(width));
        hash_append(hash_value, #3);
        hash_append(hash_value, context_value_suffix);
        hash_append(hash_value, #3);
        hash_append(hash_value, query_value);
        for payload_idx := 0 to High(payload) do
        begin
            hash_append(hash_value, #3);
            hash_append(hash_value, payload[payload_idx]);
        end;
        Result := find_score(hashes, scores, hash_value, prior_score);
    end;

begin
    difference_fragments(incumbent.text, challenger.text,
        incumbent_fragment, challenger_fragment,
        common_prefix, common_suffix);
    incumbent_remainder := pinyin_remainder(query_text,
        incumbent.full_pinyin);
    challenger_remainder := pinyin_remainder(query_text,
        challenger.full_pinyin);
    source_pair := source_code(incumbent.source) +
        source_code(challenger.source);
    category_value := category_code(category);
    bucket_value := IntToStr(Round(EnsureRange(
        selector_score - selector_threshold, -2.0, 2.0) * 2.0));
    context_units := text_units(context_value);
    for width_idx := 0 to High(c_widths) do
    begin
        width := c_widths[width_idx];
        if Length(context_units) < width then
        begin
            Continue;
        end;
        context_value_suffix := join_units(context_units,
            Length(context_units) - width, width);
        if try_key('exact', query_text, [
            incumbent.full_pinyin, incumbent.text,
            challenger.full_pinyin, challenger.text]) then
        begin
            Exit(True);
        end;
    end;
    for width_idx := 0 to High(c_widths) do
    begin
        width := c_widths[width_idx];
        if Length(context_units) < width then
        begin
            Continue;
        end;
        context_value_suffix := join_units(context_units,
            Length(context_units) - width, width);
        if try_key('diff_score', query_text, [
            incumbent_fragment, challenger_fragment,
            IntToStr(Min(common_prefix, 8)), IntToStr(Min(common_suffix, 8)),
            incumbent_remainder, challenger_remainder, source_pair,
            category_value, bucket_value]) then
        begin
            Exit(True);
        end;
    end;
    for width_idx := 0 to High(c_widths) do
    begin
        width := c_widths[width_idx];
        if Length(context_units) < width then
        begin
            Continue;
        end;
        context_value_suffix := join_units(context_units,
            Length(context_units) - width, width);
        if try_key('diff', query_text, [
            incumbent_fragment, challenger_fragment,
            IntToStr(Min(common_prefix, 8)), IntToStr(Min(common_suffix, 8)),
            incumbent_remainder, challenger_remainder, source_pair]) then
        begin
            Exit(True);
        end;
    end;
    for width_idx := 0 to High(c_widths) do
    begin
        width := c_widths[width_idx];
        if Length(context_units) < width then
        begin
            Continue;
        end;
        context_value_suffix := join_units(context_units,
            Length(context_units) - width, width);
        if try_key('diff_nq', '', [
            incumbent_fragment, challenger_fragment,
            IntToStr(Min(common_prefix, 8)), IntToStr(Min(common_suffix, 8)),
            incumbent_remainder, challenger_remainder, source_pair]) then
        begin
            Exit(True);
        end;
    end;
    prior_score := 0.0;
    Result := False;
end;

function one_key_completion_ncgpt_primary_approve_threshold(
    const category: TncOneKeyCompletionDifferenceCategory): Double;
begin
    Result := c_primary_approve[category];
end;

function one_key_completion_ncgpt_primary_veto_threshold(
    const category: TncOneKeyCompletionDifferenceCategory): Double;
begin
    Result := c_primary_veto[category];
end;

function lookup_one_key_completion_ncgpt_primary_prior(
    const context_value, query_text: string;
    const incumbent, challenger: TncOneKeyCompletion;
    const category: TncOneKeyCompletionDifferenceCategory;
    const selector_score, selector_threshold: Double;
    out prior_score: Double): Boolean;
begin
    Result := lookup_prior(c_primary_hashes, c_primary_scores,
        context_value, query_text, incumbent, challenger, category,
        selector_score, selector_threshold, prior_score);
end;

function lookup_one_key_completion_ncgpt_fallback_prior(
    const context_value, query_text: string;
    const incumbent, challenger: TncOneKeyCompletion;
    const category: TncOneKeyCompletionDifferenceCategory;
    const selector_score, selector_threshold: Double;
    out prior_score: Double): Boolean;
begin
    Result := lookup_prior(c_fallback_hashes, c_fallback_scores,
        context_value, query_text, incumbent, challenger, category,
        selector_score, selector_threshold, prior_score);
end;

function one_key_completion_ncgpt_sparse_audit_self_test: Boolean;
var
    score: Double;
begin
    Result := (hash_text('cassotis') = c_reference_hash) and
        find_score(c_primary_hashes, c_primary_scores,
        c_primary_hashes[0], score) and
        find_score(c_fallback_hashes, c_fallback_scores,
        c_fallback_hashes[High(c_fallback_hashes)], score);
end;

