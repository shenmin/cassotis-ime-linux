{ Cross-fitted independent-corpus transition evidence.
  Training report SHA-256: A82E5129A5255EBEFD113F784B3C28E301CA3DA78BA4F2A8493C2E2D45D90518
  Evidence table SHA-256: B118D6F5A5DCCEFF41C4BA932EEAD1D61F67384F3D6C23C0B63FEC4525BBA19C }

function fnv_update(const value: UInt64; const byte_value: Byte): UInt64;
begin
    Result := (value xor UInt64(byte_value)) * c_fnv_prime;
end;

function evidence_hash_value(const kind: Integer; const value: string): UInt64;
var
    idx: Integer;
    code_unit: Word;
begin
    Result := fnv_update(c_fnv_offset, Byte(kind));
    for idx := 1 to Length(value) do
    begin
        code_unit := Ord(value[idx]);
        Result := fnv_update(Result, Byte(code_unit and $FF));
        Result := fnv_update(Result, Byte(code_unit shr 8));
    end;
end;

function find_record(const hash_value: UInt64): Integer;
var
    left_idx: Integer;
    right_idx: Integer;
    middle_idx: Integer;
begin
    left_idx := 0;
    right_idx := c_long_unified_top2_evidence_record_count - 1;
    while left_idx <= right_idx do
    begin
        middle_idx := left_idx + (right_idx - left_idx) div 2;
        if c_hashes[middle_idx] = hash_value then
            Exit(middle_idx);
        if c_hashes[middle_idx] < hash_value then
            left_idx := middle_idx + 1
        else
            right_idx := middle_idx - 1;
    end;
    Result := -1;
end;

function joined_syllables(
    const values: TncLongUnifiedTop2EvidencePinyinSyllables;
    const first_index: Integer; const last_index: Integer): string;
var
    idx: Integer;
begin
    Result := '';
    for idx := first_index to last_index do
    begin
        if Result <> '' then
            Result := Result + '/';
        Result := Result + values[idx - 1];
    end;
end;

procedure assign_evidence(const kind: Integer; const key: string;
    var features: TncLongUnifiedTop2EvidenceFeatures);
var
    record_idx: Integer;
    negative_count: Cardinal;
    positive_count: Cardinal;
    total_count: Cardinal;
    offset: Integer;
begin
    record_idx := find_record(evidence_hash_value(kind, key));
    if record_idx < 0 then
        Exit;
    negative_count := c_negative_counts[record_idx];
    positive_count := c_positive_counts[record_idx];
    total_count := negative_count + positive_count;
    offset := kind * 3;
    features[offset] := Ln((positive_count + 1.0) / (negative_count + 1.0));
    features[offset + 1] := Ln(total_count + 1.0);
    features[offset + 2] :=
        (Int64(positive_count) - Int64(negative_count)) / (total_count + 2.0);
end;

procedure build_long_unified_top2_evidence_features(
    const query_syllables: TncLongUnifiedTop2EvidencePinyinSyllables;
    const top_text: string; const candidate_text: string;
    out features: TncLongUnifiedTop2EvidenceFeatures);
var
    idx: Integer;
    run_start: Integer;
    first_difference: Integer;
    last_difference: Integer;
    core: string;
    left1: string;
    right1: string;
    left2: string;
    right2: string;

    procedure append_run(const first_index: Integer; const last_index: Integer);
    begin
        if core <> '' then
            core := core + '|';
        core := core + joined_syllables(query_syllables,
            first_index, last_index) + ':' +
            Copy(top_text, first_index, last_index - first_index + 1) + '>' +
            Copy(candidate_text, first_index, last_index - first_index + 1);
    end;

begin
    FillChar(features, SizeOf(features), 0);
    if (Length(top_text) = 0) or
        (Length(top_text) <> Length(candidate_text)) or
        (Length(query_syllables) <> Length(top_text)) then
        Exit;
    core := '';
    run_start := 0;
    first_difference := 0;
    last_difference := 0;
    for idx := 1 to Length(top_text) do
    begin
        if top_text[idx] <> candidate_text[idx] then
        begin
            if first_difference = 0 then
                first_difference := idx;
            last_difference := idx;
            if run_start = 0 then
                run_start := idx;
        end
        else if run_start > 0 then
        begin
            append_run(run_start, idx - 1);
            run_start := 0;
        end;
    end;
    if run_start > 0 then
        append_run(run_start, Length(top_text));
    if core = '' then
        Exit;

    if first_difference > 1 then
    begin
        left1 := top_text[first_difference - 1];
        left2 := Copy(top_text, Max(1, first_difference - 2),
            Min(2, first_difference - 1));
    end
    else
    begin
        left1 := '^';
        left2 := '^';
    end;
    if last_difference < Length(top_text) then
    begin
        right1 := top_text[last_difference + 1];
        right2 := Copy(top_text, last_difference + 1,
            Min(2, Length(top_text) - last_difference));
    end
    else
    begin
        right1 := '$';
        right2 := '$';
    end;

    assign_evidence(0, core, features);
    assign_evidence(1, left1 + #2 + core + #2 + right1, features);
    assign_evidence(2, left1 + #2 + core, features);
    assign_evidence(3, core + #2 + right1, features);
    assign_evidence(4, left2 + #2 + core + #2 + right2, features);
end;

function long_unified_top2_evidence_self_test: Boolean;
begin
    Result := (evidence_hash_value(0, 'abc') = c_reference_hash) and
        (c_long_unified_top2_evidence_record_count > 0) and
        (find_record(c_hashes[0]) = 0) and
        (find_record(c_hashes[c_long_unified_top2_evidence_record_count - 1]) =
        c_long_unified_top2_evidence_record_count - 1);
end;

end.
