function long_local_pairwise_pool_self_test: Boolean;
var
    features: TncLongLocalPairwisePoolFeatures;
    idx: Integer;
begin
    FillChar(features, SizeOf(features), 0);
    if Abs(long_local_pairwise_pool_score(features) -
        -0.7830533422117687) > 1E-9 then
    begin
        Exit(False);
    end;
    for idx := 0 to High(features) do
    begin
        features[idx] := -1000000.0;
    end;
    if Abs(long_local_pairwise_pool_score(features) -
        -5.5818649271117646) > 1E-9 then
    begin
        Exit(False);
    end;
    for idx := 0 to High(features) do
    begin
        features[idx] := 1000000.0;
    end;
    if Abs(long_local_pairwise_pool_score(features) -
        1.8315003172575128) > 1E-9 then
    begin
        Exit(False);
    end;
    for idx := 0 to High(features) do
    begin
        if Odd(idx) then
        begin
            features[idx] := -(idx + 1) * 137.0;
        end
        else
        begin
            features[idx] := (idx + 1) * 137.0;
        end;
    end;
    Result := Abs(long_local_pairwise_pool_score(features) -
        1.5683400530153373) <= 1E-9;
end;

