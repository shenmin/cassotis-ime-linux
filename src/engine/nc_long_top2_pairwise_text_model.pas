{ Directional hashed-text evidence for the final long Top1/Top2 pair only.
  It performs no dictionary lookup and cannot add or remove candidates.
  Training report SHA-256: 602FE599307264589A161164EBC5803D38D834F3963F7CFCEE62C5AAA8E7F08F
  Model SHA-256: C1F23EBD6EEDFDA516D512FD3C5749546729A4E059C6A9BB2ACE94CCF2C23BD8 }

function fnv_update(const value: Cardinal; const item: Byte): Cardinal;
begin
    Result := Cardinal((UInt64(value xor item) * c_fnv_prime) and $FFFFFFFF);
end;

function hash_feature(const namespace_value: Byte;
    const value: string): Cardinal;
var
    hash_value: Cardinal;
    idx: Integer;
    code_unit: Word;
begin
    hash_value := fnv_update(c_fnv_offset, namespace_value);
    for idx := 1 to Length(value) do
    begin
        code_unit := Ord(value[idx]);
        hash_value := fnv_update(hash_value, Byte(code_unit and $FF));
        hash_value := fnv_update(hash_value, Byte(code_unit shr 8));
    end;
    Result := hash_value and c_long_top2_pairwise_text_hash_mask;
end;

function split_text_units(const value: string): TStringArray;
var
    idx: Integer;
    count: Integer;
    current: Word;
begin
    SetLength(Result, Length(value));
    idx := 1;
    count := 0;
    while idx <= Length(value) do
    begin
        current := Ord(value[idx]);
        if (current >= $D800) and (current <= $DBFF) and
            (idx < Length(value)) and (Ord(value[idx + 1]) >= $DC00) and
            (Ord(value[idx + 1]) <= $DFFF) then
        begin
            Result[count] := Copy(value, idx, 2);
            Inc(idx, 2);
        end
        else
        begin
            Result[count] := value[idx];
            Inc(idx);
        end;
        Inc(count);
    end;
    SetLength(Result, count);
end;

function join_units(const units: TStringArray; const start_idx: Integer;
    const width: Integer): string;
var
    idx: Integer;
begin
    Result := '';
    for idx := start_idx to start_idx + width - 1 do
        Result := Result + units[idx];
end;

procedure add_feature(var score: Int64; const namespace_value: Byte;
    const value: string; const multiplier: Integer = 1);
begin
    if value = '' then Exit;
    Inc(score, Int64(c_coefficients[hash_feature(namespace_value, value)]) *
        multiplier);
end;

procedure score_text_features(const text: string;
    const multiplier: Integer; var score: Int64);
var
    units: TStringArray;
    width: Integer;
    idx: Integer;
begin
    units := split_text_units(text);
    for width := 1 to 4 do
    begin
        for idx := 0 to Length(units) - width do
            add_feature(score, $10 + width,
                join_units(units, idx, width), multiplier);
        if Length(units) >= width then
        begin
            add_feature(score, $20 + width,
                join_units(units, 0, width), multiplier);
            add_feature(score, $30 + width,
                join_units(units, Length(units) - width, width), multiplier);
        end;
    end;
end;

