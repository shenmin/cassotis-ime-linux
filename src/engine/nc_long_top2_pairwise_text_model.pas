    idx: Integer;
    stop_idx: Integer;
    pair_text: string;
begin
    top_units := split_text_units(top_text);
    candidate_units := split_text_units(candidate_text);
    if Length(top_units) <> Length(candidate_units) then Exit;

    for idx := 0 to High(top_units) do
    begin
        if top_units[idx] = candidate_units[idx] then Continue;
        pair_text := top_units[idx] + #3 + candidate_units[idx];
        add_feature(score, $60, pair_text);
        if idx > 0 then
            add_feature(score, $61, candidate_units[idx - 1] + pair_text);
        if idx < High(candidate_units) then
            add_feature(score, $62, pair_text + candidate_units[idx + 1]);
        if (idx > 0) and (idx < High(candidate_units)) then
            add_feature(score, $63, candidate_units[idx - 1] + pair_text +
                candidate_units[idx + 1]);
    end;

    idx := 0;
    while idx < Length(top_units) do
    begin
        if top_units[idx] = candidate_units[idx] then
        begin
            Inc(idx);
            Continue;
        end;
        stop_idx := idx + 1;
        while (stop_idx < Length(top_units)) and
            (top_units[stop_idx] <> candidate_units[stop_idx]) do
            Inc(stop_idx);
        if stop_idx - idx <= 4 then
        begin
            pair_text := join_units(top_units, idx, stop_idx - idx) + #3 +
                join_units(candidate_units, idx, stop_idx - idx);
            add_feature(score, $64, pair_text);
            if idx > 0 then
                add_feature(score, $65, candidate_units[idx - 1] + pair_text);
            if stop_idx < Length(candidate_units) then
                add_feature(score, $66, pair_text + candidate_units[stop_idx]);
        end;
        idx := stop_idx;
    end;
end;

function long_top2_pairwise_text_score(const candidate_text: string;
    const top_text: string): Int64;
begin
    Result := c_long_top2_pairwise_text_intercept;
    score_text_features(candidate_text, 1, Result);
    score_text_features(top_text, -1, Result);
    score_relation_features(top_text, candidate_text, Result);
end;

function long_top2_pairwise_combined_score(const numeric_score: Int64;
    const candidate_text: string; const top_text: string): Int64;
var
    text_score: Int64;
begin
    text_score := long_top2_pairwise_text_score(candidate_text, top_text);
    Result := numeric_score + Trunc(
        text_score * c_long_top2_pairwise_text_blend_numerator *
        c_long_top2_pairwise_numeric_score_scale /
        (c_long_top2_pairwise_text_coefficient_scale *
        c_long_top2_pairwise_text_blend_denominator));
end;

function long_top2_pairwise_text_self_test: Boolean;
const
    reference_top = #$7532 + #$4E01 + #$4E19;
    reference_candidate = #$7532 + #$4E59 + #$4E19;
begin
    if long_top2_pairwise_text_score(reference_candidate, reference_top) <>
        c_long_top2_pairwise_text_reference_score then Exit(False);
    Result := long_top2_pairwise_combined_score(123456789,
        reference_candidate, reference_top) =
        c_long_top2_pairwise_combined_reference_score;
end;

end.
