procedure update_hashes(var hash1, hash2: Cardinal; const value: Byte); inline;
begin
    hash1 := (hash1 xor value) * c_hash1_prime;
    hash2 := (hash2 xor value) * c_hash2_prime;
end;

procedure update_hashes_text(var hash1, hash2: Cardinal;
    const value: string); inline;
var
    index: Integer;
    code_unit: Word;
begin
    for index := 1 to Length(value) do
    begin
        code_unit := Ord(value[index]);
        update_hashes(hash1, hash2, Byte(code_unit and $FF));
        update_hashes(hash1, hash2, Byte(code_unit shr 8));
    end;
end;

procedure append_hash_separator(var hash1, hash2: Cardinal); inline;
begin
    update_hashes(hash1, hash2, 3);
    update_hashes(hash1, hash2, 0);
end;

function finish_hash(const hash1, hash2: Cardinal): UInt64; inline;
begin
    Result := (UInt64(hash1) shl 32) or hash2;
end;

procedure hash_one(const first: string; out hash_value: UInt64); inline;
var
    hash1: Cardinal;
    hash2: Cardinal;
begin
    hash1 := c_hash1_offset;
    hash2 := c_hash2_offset;
    update_hashes_text(hash1, hash2, first);
    hash_value := finish_hash(hash1, hash2);
end;

procedure hash_two(const first, second: string;
    out hash_value: UInt64); inline;
var
    hash1: Cardinal;
    hash2: Cardinal;
begin
    hash1 := c_hash1_offset;
    hash2 := c_hash2_offset;
    update_hashes_text(hash1, hash2, first);
    append_hash_separator(hash1, hash2);
    update_hashes_text(hash1, hash2, second);
    hash_value := finish_hash(hash1, hash2);
end;

procedure hash_three(const first, second, third: string;
    out hash_value: UInt64); inline;
var
    hash1: Cardinal;
    hash2: Cardinal;
begin
    hash1 := c_hash1_offset;
    hash2 := c_hash2_offset;
    update_hashes_text(hash1, hash2, first);
    append_hash_separator(hash1, hash2);
    update_hashes_text(hash1, hash2, second);
    append_hash_separator(hash1, hash2);
    update_hashes_text(hash1, hash2, third);
    hash_value := finish_hash(hash1, hash2);
end;

function find_evidence(const hashes: array of UInt64;
    const counts: array of Cardinal; const hash_value: UInt64;
    out left_count, right_count: Integer): Boolean;
var
    low_index: Integer;
    high_index: Integer;
    middle_index: Integer;
    packed_counts: Cardinal;
begin
    low_index := 0;
    high_index := High(hashes);
    while low_index <= high_index do
    begin
        middle_index := low_index + (high_index - low_index) div 2;
        if hashes[middle_index] < hash_value then
        begin
            low_index := middle_index + 1;
        end
        else if hashes[middle_index] > hash_value then
        begin
            high_index := middle_index - 1;
        end
        else
        begin
            packed_counts := counts[middle_index];
            left_count := packed_counts and $FFFF;
            right_count := packed_counts shr 16;
            Exit(True);
        end;
    end;
    left_count := 0;
    right_count := 0;
    Result := False;
end;

function short_context_difference_lookup_pair_evidence(const top_text,
    challenger_text: string; out positive_count,
    negative_count: Integer): Boolean;
var
    hash_value: UInt64;
begin
    hash_two(top_text, challenger_text, hash_value);
    Result := find_evidence(c_pair_evidence_hashes, c_pair_evidence_counts,
        hash_value, positive_count, negative_count);
end;

function short_context_difference_lookup_pair_context_evidence(
    const suffix, top_text, challenger_text: string;
    out positive_count, negative_count: Integer): Boolean;
var
    hash_value: UInt64;
begin
    hash_three(suffix, top_text, challenger_text, hash_value);
    Result := find_evidence(c_pair_context_evidence_hashes,
        c_pair_context_evidence_counts, hash_value, positive_count,
        negative_count);
end;

function short_context_difference_lookup_mined_evidence(const suffix,
    left_text, right_text: string; out left_count,
    right_count: Integer): Boolean;
var
    hash_value: UInt64;
begin
    hash_three(suffix, left_text, right_text, hash_value);
    Result := find_evidence(c_mined_evidence_hashes, c_mined_evidence_counts,
        hash_value, left_count, right_count);
end;

function find_pair_evidence(const use_stage1: Boolean;
    const hash_value: UInt64; out left_count, right_count: Integer): Boolean;
begin
    if use_stage1 and (c_stage1_pair_overlay_count > 0) and
        find_evidence(c_stage1_pair_overlay_hashes,
        c_stage1_pair_overlay_counts, hash_value, left_count,
        right_count) then
    begin
        Exit((left_count <> 0) or (right_count <> 0));
    end;
    Result := find_evidence(c_pair_evidence_hashes, c_pair_evidence_counts,
        hash_value, left_count, right_count);
end;

function find_pair_context_evidence(const use_stage1: Boolean;
    const hash_value: UInt64; out left_count, right_count: Integer): Boolean;
begin
    if use_stage1 and (c_stage1_pair_context_overlay_count > 0) and
        find_evidence(c_stage1_pair_context_overlay_hashes,
        c_stage1_pair_context_overlay_counts, hash_value, left_count,
        right_count) then
    begin
        Exit((left_count <> 0) or (right_count <> 0));
    end;
    Result := find_evidence(c_pair_context_evidence_hashes,
        c_pair_context_evidence_counts, hash_value, left_count, right_count);
end;

function find_mined_evidence(const use_stage1: Boolean;
    const hash_value: UInt64; out left_count, right_count: Integer): Boolean;
begin
    if use_stage1 and (c_stage1_mined_overlay_count > 0) and
        find_evidence(c_stage1_mined_overlay_hashes,
        c_stage1_mined_overlay_counts, hash_value, left_count,
        right_count) then
    begin
        Exit((left_count <> 0) or (right_count <> 0));
    end;
    Result := find_evidence(c_mined_evidence_hashes, c_mined_evidence_counts,
        hash_value, left_count, right_count);
end;

function find_term(const hash_value: UInt64; out novel_count,
    chat_count, formal_count: Cardinal): Boolean;
var
    low_index: Integer;
    high_index: Integer;
    middle_index: Integer;
begin
    low_index := 0;
    high_index := High(c_term_hashes);
    while low_index <= high_index do
    begin
        middle_index := low_index + (high_index - low_index) div 2;
        if c_term_hashes[middle_index] < hash_value then
        begin
            low_index := middle_index + 1;
        end
        else if c_term_hashes[middle_index] > hash_value then
        begin
            high_index := middle_index - 1;
        end
        else
        begin
            novel_count := c_term_novel_counts[middle_index];
            chat_count := c_term_chat_counts[middle_index];
            formal_count := c_term_formal_counts[middle_index];
            Exit(True);
        end;
    end;
    novel_count := 0;
    chat_count := 0;
    formal_count := 0;
    Result := False;
end;

function evidence_confidence(const positive_count, negative_count,
    width: Integer): Double; inline;
var
    odds: Double;
begin
    odds := Ln((positive_count + 1.0) / (negative_count + 1.0));
    Result := Abs(odds) * Ln(1.0 + positive_count + negative_count) +
        width * 0.0001;
end;

procedure assign_count_features(const positive_count, negative_count: Integer;
    out positive_log, negative_log, log_odds, log_total: Double); inline;
begin
    positive_log := Ln(1.0 + positive_count);
    negative_log := Ln(1.0 + negative_count);
    log_odds := Ln((positive_count + 1.0) / (negative_count + 1.0));
    log_total := Ln(1.0 + positive_count + negative_count);
end;

function get_best_mined_evidence(const use_stage1: Boolean;
    const context_value, top_text, challenger_text: string;
    out best_positive, best_negative, best_width: Integer): Boolean;
const
    widths: array[0..7] of Integer = (1, 2, 3, 4, 6, 8, 10, 12);
var
    width_index: Integer;
    width: Integer;
    suffix: string;
    hash_value: UInt64;
    left_count: Integer;
    right_count: Integer;
    positive_count: Integer;
    negative_count: Integer;
    confidence: Double;
    best_confidence: Double;
begin
    best_confidence := 0.0;
    best_positive := 0;
    best_negative := 0;
    best_width := 0;
    for width_index := Low(widths) to High(widths) do
    begin
        width := widths[width_index];
        if Length(context_value) < width then
        begin
            Continue;
        end;
        suffix := Copy(context_value, Length(context_value) - width + 1, width);
        hash_three(suffix, top_text, challenger_text, hash_value);
        if find_mined_evidence(use_stage1, hash_value, left_count,
            right_count) then
        begin
            positive_count := right_count;
            negative_count := left_count;
        end
        else
        begin
            hash_three(suffix, challenger_text, top_text, hash_value);
            if not find_mined_evidence(use_stage1, hash_value, left_count,
                right_count) then
            begin
                Continue;
            end;
            positive_count := left_count;
            negative_count := right_count;
        end;
        confidence := evidence_confidence(positive_count, negative_count, width);
        if confidence > best_confidence then
        begin
            best_confidence := confidence;
            best_positive := positive_count;
            best_negative := negative_count;
            best_width := width;
        end;
    end;
    Result := best_width > 0;
end;

function short_context_difference_has_positive_mined_evidence(
    const context_value, top_text, challenger_text: string): Boolean;
var
    positive_count: Integer;
    negative_count: Integer;
    width: Integer;
begin
    Result := get_best_mined_evidence(False, context_value, top_text,
        challenger_text, positive_count, negative_count, width) and
        (positive_count > negative_count);
end;

function short_context_difference_has_positive_signal(const context_value,
    top_text, challenger_text: string): Boolean;
var
    hash_value: UInt64;
    positive_count: Integer;
    negative_count: Integer;
    width: Integer;
    top_novel: Cardinal;
    top_chat: Cardinal;
    top_formal: Cardinal;
    challenger_novel: Cardinal;
    challenger_chat: Cardinal;
    challenger_formal: Cardinal;
begin
    hash_two(top_text, challenger_text, hash_value);
    if find_pair_evidence(True, hash_value, positive_count, negative_count) and
        (positive_count > negative_count) then
    begin
        Exit(True);
    end;

    hash_one(top_text, hash_value);
    find_term(hash_value, top_novel, top_chat, top_formal);
    hash_one(challenger_text, hash_value);
    find_term(hash_value, challenger_novel, challenger_chat,
        challenger_formal);
    if UInt64(challenger_novel) + challenger_chat + challenger_formal >
        UInt64(top_novel) + top_chat + top_formal then
    begin
        Exit(True);
    end;

    if get_best_mined_evidence(True, context_value, top_text,
        challenger_text, positive_count, negative_count,
        width) and (positive_count > negative_count) then
    begin
        Exit(True);
    end;
    Result := False;
end;

procedure fill_evidence(const use_stage1: Boolean; const context_value,
    top_text, challenger_text: string;
    var features: TncShortContextDifferenceFeatures);
const
    widths: array[0..7] of Integer = (1, 2, 3, 4, 6, 8, 10, 12);
var
    hash_value: UInt64;
    positive_count: Integer;
    negative_count: Integer;
    width_index: Integer;
    width: Integer;
    suffix: string;
    confidence: Double;
    best_confidence: Double;
    best_positive: Integer;
    best_negative: Integer;
    best_width: Integer;
    top_novel: Cardinal;
    top_chat: Cardinal;
    top_formal: Cardinal;
    challenger_novel: Cardinal;
    challenger_chat: Cardinal;
    challenger_formal: Cardinal;
    top_total: UInt64;
    challenger_total: UInt64;
begin
    hash_two(top_text, challenger_text, hash_value);
    if find_pair_evidence(use_stage1, hash_value,
        positive_count, negative_count) then
    begin
        assign_count_features(positive_count, negative_count,
            features.pair_positive_log_count,
            features.pair_negative_log_count,
            features.pair_log_odds, features.pair_log_total);
    end;

    best_confidence := 0.0;
    best_positive := 0;
    best_negative := 0;
    best_width := 0;
    for width_index := Low(widths) to High(widths) do
    begin
        width := widths[width_index];
        if Length(context_value) < width then
        begin
            Continue;
        end;
        suffix := Copy(context_value, Length(context_value) - width + 1, width);
        hash_three(suffix, top_text, challenger_text, hash_value);
        if not find_pair_context_evidence(use_stage1, hash_value,
            positive_count, negative_count) then
        begin
            Continue;
        end;
        confidence := evidence_confidence(positive_count, negative_count, width);
        if confidence > best_confidence then
        begin
            best_confidence := confidence;
            best_positive := positive_count;
            best_negative := negative_count;
            best_width := width;
        end;
    end;
    assign_count_features(best_positive, best_negative,
        features.pair_context_positive_log_count,
        features.pair_context_negative_log_count,
        features.pair_context_log_odds, features.pair_context_log_total);
    features.pair_context_width := best_width;

    get_best_mined_evidence(use_stage1, context_value, top_text, challenger_text,
        best_positive, best_negative, best_width);
    assign_count_features(best_positive, best_negative,
        features.mined_positive_log_count,
        features.mined_negative_log_count,
        features.mined_log_odds, features.mined_log_total);
    features.mined_context_width := best_width;

    hash_one(top_text, hash_value);
    find_term(hash_value, top_novel, top_chat, top_formal);
    hash_one(challenger_text, hash_value);
    find_term(hash_value, challenger_novel, challenger_chat,
        challenger_formal);
    features.novel_top_log_count := Ln(1.0 + top_novel);
    features.novel_challenger_log_count := Ln(1.0 + challenger_novel);
    features.novel_log_odds := Ln((challenger_novel + 1.0) /
        (top_novel + 1.0));
    features.chat_top_log_count := Ln(1.0 + top_chat);
    features.chat_challenger_log_count := Ln(1.0 + challenger_chat);
    features.chat_log_odds := Ln((challenger_chat + 1.0) /
        (top_chat + 1.0));
    features.formal_top_log_count := Ln(1.0 + top_formal);
    features.formal_challenger_log_count := Ln(1.0 + challenger_formal);
    features.formal_log_odds := Ln((challenger_formal + 1.0) /
        (top_formal + 1.0));
    top_total := UInt64(top_novel) + top_chat + top_formal;
    challenger_total := UInt64(challenger_novel) + challenger_chat +
        challenger_formal;
    features.total_top_log_count := Ln(1.0 + top_total);
    features.total_challenger_log_count := Ln(1.0 + challenger_total);
    features.total_log_odds := Ln((challenger_total + 1.0) /
        (top_total + 1.0));
end;

procedure short_context_difference_fill_stage1_evidence(const context_value,
    top_text, challenger_text: string;
    var features: TncShortContextDifferenceFeatures);
begin
    fill_evidence(True, context_value, top_text, challenger_text, features);
end;

