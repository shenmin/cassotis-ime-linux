{ One authoritative swap/abstain decision over the settled long Top1/Top2.
  The model was fitted on independent-corpus hard pairs with out-of-fold,
  per-confusion-family threshold calibration.
  Training report SHA-256: 86ABF35CC6D215981ED0EBEEDD5F9203B621AF382F2F6590A0375002A0A2B242
  LightGBM model SHA-256: 9BC2E58862B8EC8058554FA3F6A5E91F5805FC20362748A238FD2810DFB8CFBD }

procedure build_long_unified_top2_arbiter_features(
    const base_features: TncLongSettledTop2ResidualFeatures;
    const top_meta: TncLongUnifiedTop2ArbiterMetaFeatures;
    const candidate_meta: TncLongUnifiedTop2ArbiterMetaFeatures;
    const aligned_difference_score: Int64;
    const expanded_difference_score: Int64; const family: Integer;
    const evidence_features: TncLongUnifiedTop2EvidenceFeatures;
    out features: TncLongUnifiedTop2ArbiterFeatures);
var
    idx: Integer;
    offset: Integer;
begin
    FillChar(features, SizeOf(features), 0);
    for idx := 0 to c_long_unified_top2_arbiter_base_feature_count - 1 do
    begin
        features[idx] := base_features[idx];
    end;
    offset := c_long_unified_top2_arbiter_base_feature_count;
    for idx := 0 to c_long_unified_top2_arbiter_meta_feature_count - 1 do
    begin
        features[offset + idx * 3] := top_meta[idx];
        features[offset + idx * 3 + 1] := candidate_meta[idx];
        features[offset + idx * 3 + 2] := candidate_meta[idx] - top_meta[idx];
    end;
    offset := offset + c_long_unified_top2_arbiter_meta_feature_count * 3;
    features[offset] := aligned_difference_score;
    Inc(offset);
    features[offset] := expanded_difference_score;
    Inc(offset);
    if (family >= 0) and (family < c_long_unified_top2_arbiter_family_count) then
    begin
        features[offset + family] := 1.0;
    end;
    offset := 284;
    for idx := 0 to 14 do
    begin
        features[offset + idx] := evidence_features[idx];
    end;
end;

