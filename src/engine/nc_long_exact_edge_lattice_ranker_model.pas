        -6.2664631573721383) > c_tolerance then
    begin
        Exit(False);
    end;
    for idx := 0 to High(features) do
    begin
        features[idx] := -100.0;
    end;
    if Abs(long_exact_edge_lattice_ranker_score(features) -
        -6.2633603631541011) > c_tolerance then
    begin
        Exit(False);
    end;
    for idx := 0 to High(features) do
    begin
        features[idx] := 100.0;
    end;
    if Abs(long_exact_edge_lattice_ranker_score(features) -
        5.748066003958785) > c_tolerance then
    begin
        Exit(False);
    end;
    for idx := 0 to High(features) do
    begin
        if Odd(idx) then
        begin
            features[idx] := -(idx + 1);
        end
        else
        begin
            features[idx] := idx + 1;
        end;
    end;
    Result := Abs(long_exact_edge_lattice_ranker_score(features) -
        -5.3952159462172293) <= c_tolerance;
end;

