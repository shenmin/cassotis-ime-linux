    out features: TncOneKeyCompletionNcgptPairFeatures);
var
    index: Integer;
begin
    for index := 0 to c_one_key_completion_ncgpt_candidate_feature_count - 1 do
    begin
        features[index] := challenger[index] - incumbent[index];
