function one_key_completion_ncgpt_self_test: Boolean;
var
    features: TncOneKeyCompletionNcgptPairFeatures;
begin
    FillChar(features, SizeOf(features), 0);
    Result := Abs(one_key_completion_ncgpt_score(features) -
        c_reference_score) < 0.000000001;
end;

